# ---------------------------------------------------------------------------
# Thok Bazar environment variables
# ---------------------------------------------------------------------------
# The app runs WITHOUT these values in "demo mode" using the bundled seed data
# in src/lib/seed. Fill them in to switch to a real Supabase backend.
#
# Get them from https://supabase.com/dashboard  ->  Project Settings  ->  API
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose to the browser. Used by admin/verification scripts.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL, used for auth redirects and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
